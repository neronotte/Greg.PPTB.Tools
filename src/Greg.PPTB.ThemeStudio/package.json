{
    "name": "@_neronotte/theme-studio",
    "version": "0.1.8",
    "displayName": "Theme Studio",
    "description": "Configure model driven app themes with a WYSIWYG UI/UX",
    "type": "module",
    "main": "index.html",
    "icon": "icons/tool.svg",
    "author": "_neronotte",
    "contributors": [
        {
            "name": "_neronotte",
            "url": "https://dev.to/_neronotte"
        }
    ],
    "license": "MIT",
    "configurations": {
        "repository": "https://github.com/neronotte/Greg.PPTB.Tools",
        "readmeUrl": "https://raw.githubusercontent.com/neronotte/Greg.PPTB.Tools/main/src/Greg.PPTB.ThemeStudio/README.md",
        "website": "https://raw.githubusercontent.com/neronotte/Greg.PPTB.Tools/main/src/Greg.PPTB.ThemeStudio/README.md"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "tsc && vite build",
        "dev": "vite",
        "watch": "vite build --watch",
        "dev-watch": "vite build --mode development --watch",
        "preview": "vite preview",
        "test": "vitest run",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "finalize-package": "npm shrinkwrap",
        "validate": "pptb-validate",
        "version-stable": "npm version patch --no-git-tag-version",
        "publish-package": "npm run build && npm run version-stable && npm publish --access public"
    },
    "dependencies": {
        "@fluentui/react-components": "^9.74.7",
        "@fluentui/react-icons": "^2.0.339",
        "chromatic": "^18.7.2",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@pptb/types": "^1.2.5",
        "@shko.online/pptb-mock": "^1.0.11",
        "@storybook/addon-docs": "^10.6.0",
        "@storybook/react": "^10.6.0",
        "@storybook/react-vite": "^10.6.0",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^6.1.1",
        "jsdom": "^30.0.1",
        "oxlint": "^1.81.0",
        "oxlint-tsgolint": "^7.0.2001",
        "storybook": "^10.6.0",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "files": [
        "dist",
        "npm-shrinkwrap.json"
    ],
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
